{
  "name": "marcador-futbolin-v3",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "MARCADOR FUTBOLÍN V3 — marcador inteligente para mesa de futbolín (versión local)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:esp32": "npm run build && node scripts/copy-to-esp32.mjs",
    "test:hardware": "sh hardware/test/check_copies.sh",
    "docs:diy": "node scripts/gen-diy-manual.mjs",
    "build:web": "npm run build && node scripts/firmware-manifests.mjs web/public/firmware && vite build -c vite.web.config.ts && node scripts/assemble-web.mjs",
    "preview:web": "vite preview -c vite.web.config.ts",
    "dev:web": "vite -c vite.web.config.ts",
    "firmware:get": "node scripts/fetch-firmware.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.6",
    "esp-web-tools": "^10.4.0",
    "qrcode-generator": "^1.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "^1.55.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@material/web": "2.2.0"
  }
}
